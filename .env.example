# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials → Desktop client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Microsoft OAuth (portal.azure.com → App registrations → your app → Certificates & secrets)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
